# Django Settings Module
# Use 'burst.settings.dev' for local development
# Use 'burst.settings.prod' for production
DJANGO_SETTINGS_MODULE=burst.settings.dev

# Django Secret Key - generate a new one for production
# You can generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-secret-key-here

# Database URL - for production use PostgreSQL
# For local development, SQLite will be used as fallback if not set
# Example PostgreSQL: postgres://user:password@localhost:5432/dbname
DATABASE_URL=

# Cloudinary Configuration (required for production file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Configuration (for sending verification/password reset emails)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Frontend URL (used for email verification and password reset links)
# For local development: http://localhost:3000
# For production: https://your-vercel-app.vercel.app
FRONTEND_URL=http://localhost:3000

# Redis URL (required for WebSocket support and chat presence)
# For local development: redis://localhost:6379
# For production: redis://redis.railway.app:6379 or your Redis provider URL
REDIS_URL=redis://localhost:6379
