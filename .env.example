# Django Settings Module
# Use 'burst.settings.dev' for local development
# Use 'burst.settings.prod' for production
DJANGO_SETTINGS_MODULE=burst.settings.dev

# Django Secret Key - generate a new one for production
# You can generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-secret-key-here

# Debug mode (True/False)
DEBUG=True

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database URL - for production use PostgreSQL
# For local development, SQLite will be used as fallback if not set
# Example PostgreSQL: postgres://user:password@localhost:5432/dbname
DATABASE_URL=

# JWT Configuration (optional, defaults: access=15min, refresh=30days)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# Redis URL (required for WebSocket support and chat presence)
# For local development: redis://localhost:6379
# For production (Upstash): the Redis protocol URL (NOT the REST HTTPS URL).
#   channels-redis needs the TLS Redis URL, e.g.:
#   rediss://default:YOUR_TOKEN@xxx.upstash.io:6379
#   Set this in Vercel as the REDIS_URL environment variable.
REDIS_URL=rediss://default:YOUR_TOKEN@xxx.upstash.io:6379

# Frontend URL (used for email verification and password reset links, CORS)
# For local development: http://localhost:3000
# For production: https://your-vercel-app.vercel.app
FRONTEND_URL=http://localhost:3000

# CORS / CSRF configuration (comma-separated origins, dev only)
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Additional production CORS/CSRF origins (comma-separated)
ADDITIONAL_CORS_ORIGINS=
ADDITIONAL_CSRF_ORIGINS=

# Email Configuration (for sending verification/password reset emails)
# Brevo SMTP defaults: host=smtp-relay.brevo.com, port=587
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-brevo-email@example.com
EMAIL_HOST_PASSWORD=your-brevo-smtp-key
DEFAULT_FROM_EMAIL=CreekTube <noreply@yourdomain.com>

# Password reset link timeout (seconds, default 24 hours)
PASSWORD_RESET_TIMEOUT=86400

# Cloudinary (for video/thumbnail storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# YouTube Data API v3 key (optional). Used to enrich metadata when a creator
# adds a YouTube video. Without it, adding still works with user-provided info.
YOUTUBE_API_KEY=your_youtube_api_key_here

# File upload limits (in bytes, default 500MB)
DATA_UPLOAD_MAX_MEMORY_SIZE=524288000
FILE_UPLOAD_MAX_MEMORY_SIZE=524288000

# Test credentials (for development/testing only)
TEST_ADMIN_USERNAME=admin
TEST_ADMIN_PASSWORD=password
TEST_BASE_URL=http://localhost:8000
TEST_WS_URL=ws://localhost:8000
