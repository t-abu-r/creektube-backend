{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "github": {
    "silent": true,
    "autoJobCancelation": true,
    "allowedBranches": ["main", "production"]
  }
}
